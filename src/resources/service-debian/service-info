#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-info
# Version:      2.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de, whoy@ukaachen.de
# Date:         13 Aug 26
# Purpose:      Service script to collect DWH package version information
#--------------------------------------

set -euo pipefail

readonly PACKAGE_NAME="__PACKAGE_NAME__"
readonly WILDFLY_SERVICE="__WILDFLY_SERVICE__"

logger -t "${PACKAGE_NAME}" -p user.info -- "A client has triggered update info socket for debian data warehouses" 2>/dev/null || true

# Checks if a debian data warehouse is installed, by searching for the wildfly.service inside deamon
ensure_debian_data_warehouse() {
  if [ -z "$(systemctl list-unit-files | grep $WILDFLY_SERVICE)" ]; then
    logger -t "${PACKAGE_NAME}" -p user.info -- "$WILDFLY_SERVICE is not installed on this host; nothing to report on" 2>/dev/null || true
    exit 0
  fi
}

ensure_update_dir() {
  mkdir -p "__AKTIN_UPDATE_DIR__"
}

ensure_update_dir_ownership() {
  if ! chown -R __WILDFLY_USER__:__WILDFLY_USER__ "__AKTIN_UPDATE_DIR__"; then
    echo "W: failed to set wildfly ownership on __AKTIN_UPDATE_DIR__" >&2
  fi
}

ensure_debian_data_warehouse
ensure_update_dir

# Get package versions
installed=$(LC_ALL=C apt-cache policy "__DWH_PACKAGE_NAME__" | sed -nE 's/^\s*Installed:\s*(.*)$/\1/p')
candidate=$(LC_ALL=C apt-cache policy "__DWH_PACKAGE_NAME__" | sed -nE 's/^\s*Candidate:\s*(.*)$/\1/p')

# Write version info
cat <<EOF >"__AKTIN_UPDATE_DIR__/info"
version.installed=${installed}
version.candidate=${candidate}
version.time=$(date)
EOF

ensure_update_dir_ownership
