#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Service script to handle DWH package updates
#--------------------------------------

set -euo pipefail

# Only a Debian-native WildFly install is in scope for this script; a Docker-based DWH
# is handled by __PACKAGE_NAME__-docker instead.
if ! systemctl list-unit-files | grep -q '^wildfly\.service'; then
  echo "E: wildfly.service is not installed on this host; nothing to update." >&2
  exit 1
fi

# Ensure update directory exists
mkdir -p "__AKTIN_UPDATE_DIR__"

# Perform update and capture result
if ! { apt-get -y -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" install "__DWH_PACKAGE_NAME__" > "__AKTIN_UPDATE_DIR__/log" 2>&1 || echo E: update failed; } | grep -q '^[WE]:'; then
  # Dirty workout-around, replace as soon as possible
  # The restart is needed because package updates may leave deployments
  # in failed state until WildFly is restarted.
  systemctl daemon-reload
  systemctl restart wildfly.service
  sleep 30
  success="true"
else
  success="false"
fi

# Write result
cat <<EOF >"__AKTIN_UPDATE_DIR__/result"
update.success=${success}
update.time=$(date)
EOF

# WildFly reads its own update status from this directory; keep it wildfly-owned.
if ! chown -R wildfly:wildfly "__AKTIN_UPDATE_DIR__"; then
  echo "W: failed to set wildfly ownership on __AKTIN_UPDATE_DIR__" >&2
fi
