[Unit]
Description=AKTIN Update-Info Service
After=network.target
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
ExecStart=__PACKAGE_NAME__-info
SyslogIdentifier=__PACKAGE_NAME__
# Restart on failure but not too frequently
Restart=on-failure
