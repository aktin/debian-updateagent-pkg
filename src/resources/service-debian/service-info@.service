# ----------------------------------------------
# Unit Name:    __PACKAGE_NAME__-info@.service
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Service unit for AKTIN update info checks
# ----------------------------------------------

[Unit]
Description=AKTIN Update-Info Service
After=network.target
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
# REMOTE_ADDR/REMOTE_PORT are set by systemd for this Accept=yes socket instance;
# unset them before running apt so its Post-Invoke hooks (which also run for
# unrelated services, e.g. the docker DWH info hook) don't mistake this debian
# socket's client for a hit on their own socket.
ExecStart=env -u REMOTE_ADDR -u REMOTE_PORT apt update
SyslogIdentifier=__PACKAGE_NAME__
# Restart on failure but not too frequently
Restart=on-failure

[Install]
WantedBy=multi-user.target
