#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-docker
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         07 Apr 26
# Purpose:      Placeholder service script for Docker-based update execution
#--------------------------------------

set -euo pipefail

# Ensure update directory exists
mkdir -p "__AKTIN_UPDATE_DIR__"

client_ip="${REMOTE_ADDR:-}"
client_port="${REMOTE_PORT:-}"

# Get compose prefix
dwh_prefix="$(
  docker ps -q | while read -r cid; do
    docker inspect \
    --format '{{.Id}} {{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}} {{index .Config.Labels "com.docker.compose.project"}}' \
    "$cid"
  done | awk -v ip="$client_ip" '$0 ~ ip {print $NF; exit}'
)"

if [[ -z "$dwh_prefix" ]]; then
  echo "Could not determine Docker Compose project for client IP: ${client_ip}" >&2
  exit 1
fi

# ensure update dir
update_dir="/var/lib/docker/volumes/${dwh_prefix}_aktin_data/_data/update"
mkdir -p "$update_dir"

# find location of compose file
compose_container="${dwh_prefix}-wildfly-1"
compose_working_dir="$(docker inspect "$compose_container" --format='{{index .Config.Labels "com.docker.compose.project.working_dir"}}')"
compose_config_files="$(docker inspect "$compose_container" --format='{{index .Config.Labels "com.docker.compose.project.config_files"}}')"

if [[ -n "$compose_working_dir" ]]; then
  compose_dir="$compose_working_dir"
elif [[ -n "$compose_config_files" ]]; then
  compose_dir="$(dirname "${compose_config_files%%,*}")"
else
  echo "Could not determine Docker Compose directory for container: ${compose_container}" >&2
  exit 1
fi

if [[ ! -d "$compose_dir" ]]; then
  echo "Docker Compose directory does not exist: ${compose_dir}" >&2
  exit 1
fi

# safe wildfly log before update
sudo docker cp "$dwh_prefix-wildfly-1":/opt/wildfly/standalone/log/server.log "$update_dir"

# Execute update
cd "$compose_dir"
sudo docker compose down
curl -LO https://github.com/aktin/docker-aktin-dwh/releases/latest/download/compose.yml
sudo docker compose pull
sudo docker compose up -d
sudo docker image prune


# check if update was successful
installed=$(sudo docker exec "$dwh_prefix"-wildfly-1 /opt/wildfly/bin/jboss-cli.sh --connect --command="deployment-info" \
  | grep 'dwh-j2ee-.*\.ear' \
  | awk '{print $1}' \
  | sed 's/dwh-j2ee-\(.*\)\.ear/\1/')
candidate=$(grep "version.candidate" info | awk -F'=' '{print $2}')
if [[ "$installed" == "$candidate" ]]; then
  success="true"
else
  success="false"
fi
echo "==> Update finished, installed: $installed, candidate was $candidate. Update successful: $success"


# Placeholder for future Docker update execution logic
cat <<EOF >"$update_dir/docker-result"
update.success=${success}
update.time=$(date)
update.message=not_implemented
request.client_ip=${client_ip}
request.client_port=${client_port}
EOF


# --------- CLEANUP ----------------------------
# copy old update log into new container
sudo docker cp "$update_dir/server.log" "$dwh_prefix-wildfly-1":/opt/wildfly/standalone/log/server.log.1
rm "$update_dir/server.log"
rm "$update_dir/info"
