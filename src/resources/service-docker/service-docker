#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-docker
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         07 Apr 26
# Purpose:      Service script to handle DWH package updates for docker DWHs
#--------------------------------------

set -euo pipefail

client_ip="${REMOTE_ADDR:-}"
client_port="${REMOTE_PORT:-}"

source "/usr/lib/__PACKAGE_NAME__/helpers.sh"

log "Start updating Docker DWH"
dwh_prefix="$(get_compose_prefix_from_ip $client_ip)"
wildfly_container="$dwh_prefix-wildfly-1"
update_dir="$(docker_ensure_update_dir $dwh_prefix)"
exec > >(tee -a "$update_dir/log") 2>&1
compose_dir="$(docker_get_compose_location_by_container $wildfly_container)"

# --------- Pre-update preparation ----------------------------
sudo docker cp "$wildfly_container":/opt/wildfly/standalone/log/server.log "$update_dir"

# --------- Main update process----------------------------
log "Starting Docker update process"
cd "$compose_dir"
sudo docker compose down
curl -LO https://github.com/aktin/docker-aktin-dwh/releases/latest/download/compose.yml
sudo docker compose pull
sudo docker compose up -d
docker_wait_for_deployment "$wildfly_container"
successful="$(docker_post_update_validation $wildfly_container $update_dir)"

cat <<EOF >"$update_dir/result"
update.success=${successful}
update.time=$(date)
update.message=not_implemented
request.client_ip=${client_ip}
request.client_port=${client_port}
EOF

# --------- CLEANUP ----------------------------
# copy old update log into new container
sudo docker cp "$update_dir/server.log" "$dwh_prefix-wildfly-1":/opt/wildfly/standalone/log/server.log.1

