#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-docker-info
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         13 Aug 26
# Purpose:      Service script to collect DWH package version information for docker DWHs
#--------------------------------------

set -euo pipefail

readonly client_ip="${REMOTE_ADDR:-}"
readonly client_port="${REMOTE_PORT:-}"

source "__PACKAGE_LIB_DIR__/helpers.sh"

# writes a summary file to a docker data warehouse. This file contains package versions, the data warehouse
# can use to interpret update necessity
write_tenant_info() {
  local dwh_prefix="$1"
  local latest="$2"
  log "Collecting tenant info for $dwh_prefix"

  local wildfly_container="${dwh_prefix}__WILDFLY_CONTAINER_SUFFIX__"
  local update_dir installed
  update_dir="$(docker_ensure_update_dir "$dwh_prefix")"
  installed="$(docker_get_currently_deployed_version "$wildfly_container")"

  log "Save tenant info summary to update directory"
  cat <<EOF > "$update_dir/info"
version.installed=${installed}
version.candidate=${latest}
version.time=$(date)

request.client_ip=${client_ip}
request.client_port=${client_port}
request.client_prefix=${dwh_prefix}
EOF
}


log "A client has triggered update info socket for docker data warehouses"
# verify docker exists on host
if ! command -v docker >/dev/null 2>&1; then
  log "docker is not available on this host; nothing to report on"
  exit 0
fi

# Main logic to write update summaries to docker. It distinguishes if a request came
# from a single data warehouse or from an apt hook.
latest="$(get_latest_j2ee_release)"
if [[ -z "$client_ip" ]]; then
  log "non-dwh client identified"
  # This code runs when the script has no client. For example, if triggered by apt post-invoke hook
  prefixes="$(docker_get_all_compose_prefixes)"
  if [[ -z "$prefixes" ]]; then
    log "no docker DWH tenants found on this host; nothing to report on"
    exit 0
  fi

  # write update info to each docker data warehouse. Logs and skips a tenant, if update info could not be written.
  while IFS= read -r dwh_prefix; do
    set +e
    ( set -e; write_tenant_info "$dwh_prefix" "$latest" )
    rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
      log "Failed to write update info for tenant ${dwh_prefix} (exit ${rc}), skipping"
    fi
  done <<<"$prefixes"
  exit 0
else
  log "dwh client identified"
  # This code runs when a specific client requested an update info. Creates the info file only for that client.
  dwh_prefix="$(get_compose_prefix_from_ip $client_ip)"
  write_tenant_info "$dwh_prefix" "$latest"
  exit 0
fi

