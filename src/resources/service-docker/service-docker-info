#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-docker-info
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         31 Aug 26
# Purpose:      Service script to collect DWH package version information for docker DWHs
#--------------------------------------

set -euo pipefail

readonly client_ip="${REMOTE_ADDR:-}"
readonly client_port="${REMOTE_PORT:-}"

source "__PACKAGE_LIB_DIR__/helpers.sh"

# writes a summary file to a docker data warehouse. This file contains package versions, the data warehouse
# can use to interpret update necessity
write_tenant_info() {
  local dwh_prefix="$1"
  local latest="$2"
  log_docker_info "Collecting tenant info for $dwh_prefix"

  local wildfly_container="${dwh_prefix}__WILDFLY_CONTAINER_SUFFIX__"
  local update_dir installed update_filepath
  update_dir="$(docker_ensure_update_dir "$dwh_prefix")"
  update_filepath="$update_dir/info"

  # always remove old info file to avoid misconceptions
  rm "$update_filepath" || log_docker_info "No previous update info file found at $update_filepath. No removal required."

  # only write update-info file if wildfly is deployed
  if ! docker_is_wildfly_deployed "$wildfly_container"; then
    log_docker_warn "Wildfly not started yet. Attempt to run update-info later to create the info file."
  else
    installed="$(docker_get_currently_deployed_version "$wildfly_container")"

    write_file_atomically "$update_filepath" <<EOF
version.installed=${installed}
version.candidate=${latest}
version.time=$(date)

request.client_ip=${client_ip}
request.client_port=${client_port}
request.client_prefix=${dwh_prefix}
EOF
    log_docker_info "Saved tenant info summary to update directory"
  fi
}


log_docker_info "A client has triggered update info socket for docker data warehouses"
# verify docker exists on host
if ! command -v docker >/dev/null 2>&1; then
  log_docker_info "docker is not available on this host; nothing to report on"
  exit 0
fi

latest="$(get_latest_j2ee_release)"
dwh_prefix="$(get_compose_prefix_from_ip $client_ip)"
write_tenant_info "$dwh_prefix" "$latest"

