#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         14 Okt 26
# Purpose:      Enable/Disable socket groups on host
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

# Define socket groups
readonly DEBIAN_SOCKETS=(
  "${PACKAGE_NAME}.socket"
  "${PACKAGE_NAME}-info.socket"
)
readonly DOCKER_SOCKETS=(
  "${PACKAGE_NAME}-docker.socket"
  "${PACKAGE_NAME}-docker-info.socket"
)

# Prints the activity state of each socket. Missing unit files are reported as "not installed"
print_status() {
  local socket state
  for socket in "${DEBIAN_SOCKETS[@]}" "${DOCKER_SOCKETS[@]}"; do
    if [[ "$(systemctl show --property=LoadState --value "${socket}")" == "not-found" ]]; then
      state="not installed"
    else
      state="$(systemctl is-active "${socket}")"
    fi
    printf '%-45s %s\n' "${socket}" "${state}"
  done
}

main() {
  local operation="${1:-}"

  case "${operation}" in
    status)
      print_status
      ;;
    docker-start)
      systemctl enable --now "${DOCKER_SOCKETS[@]}"
      ;;
    docker-stop)
      systemctl disable --now "${DOCKER_SOCKETS[@]}"
      ;;
    debian-start)
      systemctl enable --now "${DEBIAN_SOCKETS[@]}"
      ;;
    debian-stop)
      systemctl disable --now "${DEBIAN_SOCKETS[@]}"
      ;;
    *)
      echo "command not found, try: status, docker-start, docker-stop, debian-start, debian-stop"
      exit 1
      ;;
  esac
}

main "$@"

