#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-socket-setup
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         09 Apr 26
# Purpose:      Applies host-specific runtime setup for an AKTIN instance.
#--------------------------------------

set -euo pipefail

readonly PACKAGE_NAME="__PACKAGE_NAME__"
readonly UPDATE_DIR="__AKTIN_UPDATE_DIR__"
readonly SOCKET_UNITS=(
  "${PACKAGE_NAME}.socket"
  "${PACKAGE_NAME}-info.socket"
  "${PACKAGE_NAME}-docker.socket"
  "${PACKAGE_NAME}-docker-info.socket"
)

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; }

require_wildfly_user() {
  log_info "Checking for wildfly user"
  if ! getent passwd wildfly >/dev/null; then
    log_error "The 'wildfly' user is required for instance setup but is not present."
    exit 1
  fi
}

init_update_directory() {
  log_info "Creating AKTIN update directory..."
  mkdir -p "${UPDATE_DIR}"
  log_success "Update directory created"
}

set_wildfly_permissions() {
  log_info "Setting Wildfly permissions for update directory..."
  chown -R wildfly:wildfly "${UPDATE_DIR}"
  log_success "Wildfly permissions set successfully"
}

setup_socket_services() {
  log_info "Enabling and starting socket services..."
  systemctl daemon-reload
  log_info "deamon reloaded"
  systemctl enable "${SOCKET_UNITS[@]}"
  log_info "${SOCKET_UNITS[@]}"
  log_info "sockets enabled"
  systemctl start "${SOCKET_UNITS[@]}"
  log_success "Socket services initialized"
}

stop_socket_services() {
  if ! command -v systemctl >/dev/null 2>&1; then
    log_warn "systemctl is not available; skipping socket shutdown"
    return
  fi

  log_info "Stopping socket services..."
  if ! systemctl stop "${SOCKET_UNITS[@]}"; then
    log_warn "Failed to stop one or more socket services"
  fi

  if ! systemctl disable "${SOCKET_UNITS[@]}"; then
    log_warn "Failed to disable one or more socket services"
  fi
  log_success "Socket services stopped and disabled"
}


usage() {
  echo "Usage: $0 <configure|remove>" >&2
  exit 1
}

main() {
  local operation="${1:-}"

  case "${operation}" in
    configure)
#      require_wildfly_user
#      require_systemd
      init_update_directory
#      set_wildfly_permissions
      setup_socket_services
      ;;
    remove)
      stop_socket_services
      # todo: function to delete sockets
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
