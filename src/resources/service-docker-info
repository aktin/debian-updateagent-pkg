set -euo pipefail

client_ip="${REMOTE_ADDR:-}"
client_port="${REMOTE_PORT:-}"
#source summary_aktin-updateagent_preinstall.txt

# read TCP message or leave empty if none
compose_dir=""
dwh_prefix=""
update_dir=""

mkdir -p "__AKTIN_UPDATE_DIR__"

request_message=""
IFS= read -r -t 2 request_message || true

compose_location=""
case "$request_message" in
  compose.location=*)
    compose_location="${request_message#compose.location=}"
    ;;
esac

cat <<EOF > "__AKTIN_UPDATE_DIR__/info.txt"
version.installed=
version.candidate=
version.time=$(date)
version.message=${request_message}
request.client_ip=${client_ip}
request.client_port=${client_port}
EOF


