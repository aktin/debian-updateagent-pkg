#!/bin/bash
#--------------------------------------
# Script Name:  __PACKAGE_NAME__-docker-info
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         07 Apr 26
# Purpose:      Placeholder service script for Docker-based update information
#--------------------------------------

set -euo pipefail

client_ip="${REMOTE_ADDR:-}"
client_port="${REMOTE_PORT:-}"
#source summary_aktin-updateagent_preinstall.txt

# read TCP message or leave empty if none
compose_dir=""
dwh_prefix=""
update_dir=""

dwh_prefix="$(
  docker ps -q | while read -r cid; do
    docker inspect \
    --format '{{.Id}} {{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}} {{index .Config.Labels "com.docker.compose.project"}}' \
    "$cid"
  done | awk -v ip="$client_ip" '$0 ~ ip {print $NF; exit}'
)"

echo "debug: value=$dwh_prefix" >&2
update_dir="/var/lib/docker/volumes/${dwh_prefix}_aktin_data/_data/update"
mkdir -p "$update_dir"

installed=$(sudo docker exec "$dwh_prefix"-wildfly-1 /opt/wildfly/bin/jboss-cli.sh --connect --command="deployment-info" \
  | grep 'dwh-j2ee-.*\.ear' \
  | awk '{print $1}' \
  | sed 's/dwh-j2ee-\(.*\)\.ear/\1/')
LATEST_TAG=$(curl -s https://api.github.com/repos/aktin/dwh-j2ee/tags \
  | grep -oP '"name":\s*"\K[^"]+' \
  | sort -V \
  | tail -1)

cat <<EOF > "$update_dir/info"
version.installed=${installed}
version.candidate=${LATEST_TAG}
version.time=$(date)

request.client_ip=${client_ip}
request.client_port=${client_port}
request.client_prefix=${dwh_prefix}
EOF
