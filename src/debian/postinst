#!/bin/bash
#--------------------------------------
# Script Name:  postinst
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Configures the package after files are unpacked by initializing services, databases, and required configurations to make the package operational.
#--------------------------------------

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; }

readonly OPERATION="${1}"
readonly UPDATE_DIR="/var/lib/aktin/update"
readonly INSTANCE_SETUP_SCRIPT="/usr/lib/__PACKAGE_NAME__/socket-setup"

read_preinst_summary() {
  source summary_aktin-updateagent_preinstall.txt
}

init_update_directory() {
  log_info "Creating AKTIN update directory..."
  if ! mkdir -p "${UPDATE_DIR}"; then
    log_error "Failed to create update directory"
    exit 1
  fi
  log_success "Update directory created"
}

docker_init_update_directories() {
  local volumes_basedir="/var/lib/docker/volumes/"
  find "$volumes_basedir" -type d -name "*_aktin_data" -print0 |
  while IFS= read -r -d '' dir; do
    log_info "found docker data path: $dir"
    local update_dir="$dir/_data/update"
    mkdir -p "$update_dir"
    log_success "created update dir: $update_dir"
  done
}

init_update_directories() {
  [ debian_installed ] && init_update_directory
  [ docker_installed ] && docker_init_update_directories
}

reload_systemd() {
  if command -v systemctl >/dev/null 2>&1; then
    log_info "Reloading systemd daemon..."
    if ! systemctl daemon-reload; then
      log_error "Failed to reload systemd daemon"
      exit 1
    fi
    log_success "Systemd daemon reloaded"
  else
    log_warn "systemctl is not available; skipping daemon reload"
  fi
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    configure)
      # Runs during installation/upgrade after files have been unpacked.
      # Host-specific setup is intentionally deferred to the instance helper.
      init_update_directories
      reload_systemd
      "${INSTANCE_SETUP_SCRIPT}" configure
      ;;
  esac
}

main "$@"
