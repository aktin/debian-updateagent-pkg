#!/bin/bash
#--------------------------------------
# Script Name:  postinst
# Version:      2.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de, whoy@ukaachen.de
# Date:         13 Okt 26
# Purpose:      Ensures central logging is active. Initiates socket creation.
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }

main() {
  set -euo pipefail
  case "${1}" in
    configure)
      "__PACKAGE_LIB_DIR__/socket-setup" configure
      log_warn "Installed and activated multiple TCP sockets. You can manually control them inside CLI using: '${PACKAGE_NAME}-sockets <status|docker-start|docker-stop|debian-start|debian-stop>"
      ;;
    abort-upgrade|abort-remove|abort-deconfigure)
      ;;
  esac
}

main "$@"
