#!/bin/bash
#--------------------------------------
# Script Name:  postinst
# Version:      2.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de, whoy@ukaachen.de
# Date:         13 Okt 26
# Purpose:      Ensures central logging is active. Initiates socket creation.
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.info -- "$1" 2>/dev/null || true; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }

# Enable the update-agent sockets and the apt-refresh timer on a fresh install (empty previous
# version), then start every enabled unit. On upgrade, groups the admin disabled stay disabled.
setup_socket_services() {
  local previous_version="$1"
  local units=("${DEBIAN_SOCKETS[@]}" "${DOCKER_SOCKETS[@]}")
  local enabled_units=() unit

  log_info "Enabling and starting socket services..."
  if systemctl daemon-reload; then
    log_info "daemon reloaded"
  else
    log_warn "Failed to reload systemd daemon"
  fi

  if [[ -z "${previous_version}" ]]; then
    if systemctl enable "${units[@]}"; then
      log_info "enabled ${units[*]}"
    else
      log_warn "Failed to enable one or more socket/timer units"
    fi
  fi

  for unit in "${units[@]}"; do
    if systemctl is-enabled --quiet "${unit}"; then
      enabled_units+=("${unit}")
    fi
  done
  if [[ ${#enabled_units[@]} -eq 0 ]]; then
    log_info "No socket/timer units enabled; nothing to start"
    return
  fi

  if systemctl start "${enabled_units[@]}"; then
    log_info "started ${enabled_units[*]}"
  else
    log_warn "Failed to start one or more socket/timer units"
  fi
}

main() {
  set -euo pipefail
  case "${1}" in
    configure)
      source "__PACKAGE_LIB_DIR__/helpers.sh"
      setup_socket_services "${2:-}"
      echo "Installed and activated multiple TCP sockets. You can manually control them inside CLI using: '${PACKAGE_NAME} <status|start|stop> <docker|debian>'"
      ;;
    abort-upgrade|abort-remove|abort-deconfigure)
      ;;
  esac
}

main "$@"
