#!/bin/bash
#--------------------------------------
# Script Name:  postinst
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Configures the package after files are unpacked by initializing services, databases, and required configurations to make the package operational.
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.info -- "$1" 2>/dev/null || true; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.notice -- "$1" 2>/dev/null || true; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; logger -t "${PACKAGE_NAME}" -p user.err -- "$1" 2>/dev/null || true; }

readonly OPERATION="${1}"
readonly UPDATE_DIR="__AKTIN_UPDATE_DIR__"
readonly INSTANCE_SETUP_SCRIPT="__PACKAGE_LIB_DIR__/socket-setup"
source __PREINSTALL_SUMMARY_FILE__


reload_systemd() {
  if command -v systemctl >/dev/null 2>&1; then
    log_info "Reloading systemd daemon..."
    if ! systemctl daemon-reload; then
      log_error "Failed to reload systemd daemon"
      exit 1
    fi
    log_success "Systemd daemon reloaded"
  else
    log_warn "systemctl is not available; skipping daemon reload"
  fi
}

ensure_persistent_journal() {
  if ! command -v journalctl >/dev/null 2>&1; then
    log_error "journalctl is not available; the persistent journal is the main logging target and installation cannot continue"
    exit 1
  fi

  if [[ -d __JOURNAL_DIR__ ]]; then
    log_info "Persistent journal storage already present at __JOURNAL_DIR__"
    return
  fi

  log_info "Enabling persistent journal storage so package logs survive reboots..."
  mkdir -p __JOURNAL_DIR__
  if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create --prefix __JOURNAL_DIR__ || log_warn "Failed to set up __JOURNAL_DIR__ permissions"
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart systemd-journald || log_warn "Failed to restart systemd-journald"
  fi
  log_success "Persistent journal storage enabled"
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    configure)
      # Runs during installation/upgrade after files have been unpacked.
      # Host-specific setup is intentionally deferred to the instance helper.
      ensure_persistent_journal
      "${INSTANCE_SETUP_SCRIPT}" configure
      ;;
  esac
}

main "$@"
