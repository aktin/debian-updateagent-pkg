#!/bin/bash
#--------------------------------------
# Script Name:  prerm
# Version:      2.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de, whoy@ukaachen.de
# Date:         02 Okt 26
# Purpose:      Prepares the system before package files are removed, by stopping systemd sockets

#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"
readonly OPERATION="${1}"

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.info -- "$1" 2>/dev/null || true; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }

# Take all update-agent units down with the given systemctl verb: "stop" before an upgrade
# (so a changed ListenStream/Accept takes effect on restart), "disable --now" on removal.
teardown_socket_services() {
  if ! command -v systemctl >/dev/null 2>&1; then
    log_warn "systemctl is not available; skipping 'systemctl $*'"
    return
  fi

  if systemctl "$@" "${DEBIAN_SOCKETS[@]}" "${DOCKER_SOCKETS[@]}"; then
    log_info "systemctl $* succeeded for all socket/timer units"
  else
    log_warn "systemctl $* failed for one or more socket/timer units"
  fi
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    remove)
      # Runs during package removal before files are deleted.
      source "__PACKAGE_LIB_DIR__/helpers.sh"
      teardown_socket_services disable --now
      ;;
    upgrade)
      # Stop sockets, so later "postinst configure" step starts inactive sockets directly, with changed ListenStream/Accept
      source "__PACKAGE_LIB_DIR__/helpers.sh"
      teardown_socket_services stop
      ;;
  esac
}

main "$@"
