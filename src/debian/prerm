#!/bin/bash
#--------------------------------------
# Script Name:  prerm
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Prepares the system before package files are removed by stopping services, backing up user data, and cleaning runtime artifacts.
#--------------------------------------

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; }

readonly OPERATION="${1}"
readonly INSTANCE_SETUP_SCRIPT="/usr/lib/__PACKAGE_NAME__/instance-setup"

run_instance_cleanup() {
  if [[ -x "${INSTANCE_SETUP_SCRIPT}" ]]; then
    log_info "Running instance-specific cleanup..."
    if ! "${INSTANCE_SETUP_SCRIPT}" remove; then
      log_warn "Instance-specific cleanup reported an error"
    fi
  else
    log_warn "Instance setup helper not found at ${INSTANCE_SETUP_SCRIPT}; skipping instance cleanup"
  fi
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    remove)
      # Runs during package removal before files are deleted.
      run_instance_cleanup
      ;;
    upgrade)
      # Runs during package upgrade before old files are deleted.
      ;;
  esac
}

main "$@"
