#!/bin/bash
#--------------------------------------
# Script Name:  prerm
# Version:      1.0
# Authors:      skurka@ukaachen.de, akombeiz@ukaachen.de
# Date:         14 Nov 24
# Purpose:      Prepares the system before package files are removed by stopping services, backing up user data, and cleaning runtime artifacts.
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.info -- "$1" 2>/dev/null || true; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.notice -- "$1" 2>/dev/null || true; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; logger -t "${PACKAGE_NAME}" -p user.err -- "$1" 2>/dev/null || true; }

readonly OPERATION="${1}"
readonly SOCKET_MANAGEMENT_SCRIPT="/usr/lib/__PACKAGE_NAME__/socket-setup"


rm_update_directory() {
  if [[ -d "__AKTIN_UPDATE_DIR__" ]]; then
    rm -r "__AKTIN_UPDATE_DIR__"
    log_success "Removed debian update directory at: __AKTIN_UPDATE_DIR__"
  fi
}

docker_rm_update_directories() {
  local volumes_basedir="__DOCKER_VOLUMES_DIR__"
  while IFS= read -r -d '' dir; do
    rm -r "$dir"
    log_success "removed docker update folder: $dir"
  done < <(find "$volumes_basedir" -type d -wholename "*_aktin_data/_data/update" -print0)
}

rm_update_directories() {
  rm_update_directory
  docker_rm_update_directories
}


run_instance_cleanup() {
  if [[ -x "${SOCKET_MANAGEMENT_SCRIPT}" ]]; then
    log_info "Running instance-specific cleanup..."
    if ! "${SOCKET_MANAGEMENT_SCRIPT}" remove; then
      log_warn "Instance-specific cleanup reported an error"
    fi
  else
    log_warn "Instance setup helper not found at ${SOCKET_MANAGEMENT_SCRIPT}; skipping instance cleanup"
  fi
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    remove)
      # Runs during package removal before files are deleted.
      run_instance_cleanup
      rm_update_directories
      ;;
    upgrade)
      # Runs during package upgrade before old files are deleted.
      ;;
  esac
}

main "$@"
