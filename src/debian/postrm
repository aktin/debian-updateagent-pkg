#!/bin/bash
#--------------------------------------
# Script Name:  postrm
# Version:      1.0
# Authors:      whoy@ukaachen.de
# Date:         24 Aug 26
# Purpose:      Reload systemd after unit files are gone; on purge, drop persisted update data.
#--------------------------------------

readonly PACKAGE_NAME="__PACKAGE_NAME__"

log_info() { echo -e "\033[0;34m[INFO]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.info -- "$1" 2>/dev/null || true; }
log_success() { echo -e "\033[0;32m[SUCCESS]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.notice -- "$1" 2>/dev/null || true; }
log_warn() { echo -e "\033[1;33m[WARN]\033[0m $1"; logger -t "${PACKAGE_NAME}" -p user.warning -- "$1" 2>/dev/null || true; }
log_error() { echo -e "\033[0;31m[ERROR]\033[0m $1" >&2; logger -t "${PACKAGE_NAME}" -p user.err -- "$1" 2>/dev/null || true; }

readonly OPERATION="${1}"

reload_systemd() {
  if command -v systemctl >/dev/null 2>&1; then
    log_info "Reloading systemd daemon..."
    if ! systemctl daemon-reload; then
      log_warn "Failed to reload systemd daemon"
    fi
    log_info "Clearing failed unit instances..."
    if ! systemctl reset-failed "__PACKAGE_NAME__*"; then
      log_warn "Failed to clear failed unit instances"
    fi
  else
    log_warn "systemctl is not available; skipping daemon reload"
  fi
}

rm_update_directory() {
  if [[ -d "__AKTIN_UPDATE_DIR__" ]]; then
    if rm -r "__AKTIN_UPDATE_DIR__"; then
      log_success "Removed debian update directory at: __AKTIN_UPDATE_DIR__"
    else
      log_warn "Failed to remove debian update directory at: __AKTIN_UPDATE_DIR__"
    fi
  fi
}

docker_rm_update_directories() {
  local volumes_basedir="__DOCKER_VOLUMES_DIR__"
  while IFS= read -r -d '' dir; do
    if rm -r "$dir"; then
      log_success "removed docker update folder: $dir"
    else
      log_warn "Failed to remove docker update folder: $dir"
    fi
  done < <(find "$volumes_basedir" -type d -wholename "*_aktin_data/_data/update" -print0)
}

rm_update_directories() {
  rm_update_directory
  docker_rm_update_directories
}

main() {
  set -euo pipefail
  case "$OPERATION" in
    remove)
      # Runs after package files (including systemd unit files) have already been deleted.
      reload_systemd
      ;;
    purge)
      # Runs after package files have been deleted; the user explicitly asked to remove all traces.
      reload_systemd
      rm_update_directories
      ;;
    upgrade|failed-upgrade|disappear)
      ;;
  esac
}

main "$@"
